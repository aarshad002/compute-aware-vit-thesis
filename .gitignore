*.pt
*.pth
*.ckpt
*.onnx

# ── Large raw run transcripts ──────────────────────────
# Keep small SLURM .out/.err logs and the logs/README.md; drop bulky *.log.
*.log
wandb/

# ── Jupyter ────────────────────────────────────────────
.ipynb_checkpoints/

# ── Editor / OS / tooling ──────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/

# ── Thesis manuscript and working notes (kept out of the code repository) ──
thesis_overleaf/
extra/
user_inputs.txt
